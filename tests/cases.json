[
  {
    "name": "request metrics timeline",
    "request": {
      "events": [
        {
          "timestamp": "2026-10-01T00:00:00Z",
          "level": "info",
          "message": "start",
          "request_id": "r",
          "duration_ms": 10
        },
        {
          "timestamp": "2026-10-01T00:00:01+00:00",
          "level": "error",
          "message": "failed",
          "request_id": "r",
          "duration_ms": 20
        }
      ]
    },
    "expected": {
      "metrics/count": 2,
      "metrics/errors": 1,
      "metrics/duration_p95_ms": 20,
      "groups/0/elapsed_seconds": 1
